# Production .env for /opt/chichipolies/src/.env. Fill every blank before the
# first deploy. Never commit the real file.
APP_NAME=Chichipolies
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://chichipolies.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# PostgreSQL in the shared outreach-postgres container on mig_net.
DB_CONNECTION=pgsql
DB_HOST=outreach-postgres
DB_PORT=5432
DB_DATABASE=chichipolies
DB_USERNAME=chichipolies
DB_PASSWORD=

# Shared Redis, keys prefixed so other apps on the box never collide.
REDIS_CLIENT=phpredis
REDIS_HOST=mig-redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_PREFIX=chichipolies_
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
# Story photos: public (this server; deploy.sh runs storage:link) or r2.
PHOTOS_DISK=public
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

# Mail through the Zoho mailbox that already owns chichipolies.com's MX, SPF
# and DKIM. Use an app-specific password from Zoho, not the mailbox password.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.zoho.eu
MAIL_PORT=587
MAIL_USERNAME=hello@chichipolies.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@chichipolies.com
MAIL_FROM_NAME="${APP_NAME}"

ANTHROPIC_API_KEY=
PLATFORM_OWNER_EMAIL=

VITE_APP_NAME="${APP_NAME}"
